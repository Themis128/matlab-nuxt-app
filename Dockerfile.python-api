# matlab-nuxt-app Python prediction API — self-hosted image.
# Build context is the REPO ROOT (needs python_api/, data/, public/):
#   docker build -f Dockerfile.python-api -t matlab-python-api .
# Deployed on omv (aarch64) as container `matlab-python-api`, port 8010,
# exposed publicly as https://matlab-api.cloudless.gr via the omv-cloudless
# Cloudflare Tunnel. Vercel reads it via the PYTHON_API_URL env var.
FROM python:3.12-slim

# libgomp1: OpenMP runtime required by LightGBM/XGBoost pickled models
# (joblib.load fails with "libgomp.so.1: cannot open shared object file")
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY python_api/requirements-runtime.txt /app/requirements-runtime.txt
RUN pip install -r /app/requirements-runtime.txt

COPY python_api /app/python_api
COPY data /app/data
COPY public/dataset_with_images.csv /app/public/dataset_with_images.csv

WORKDIR /app/python_api
EXPOSE 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
